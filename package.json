{
  "name": "togen-mobile-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run pdf:build",
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "pdf:build": "node --import tsx scripts/build-pdf.ts",
    "grant": "node --import tsx scripts/grant.ts",
    "migrate": "node --import tsx scripts/import-sqlite.ts",
    "forms": "node --import tsx scripts/generate-forms.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.0",
    "playwright": "^1.51.0",
    "sql.js": "^1.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.9",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
