{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@shared/*": [
        "shared/*"
      ]
    },
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strictNullChecks": false,
    "noImplicitAny": false
  },
  "include": [
    "src",
    "backend",
    "shared",
    "scripts",
    "tests"
  ],
  "exclude": [
    "src/utils/*PdfGenerator.ts",
    "src/lib/utils.ts"
  ]
}